# ==============================================================================
# SRMP Multi-Tenant SaaS - Staging Environment Configuration
# Render Web Service + Render Managed PostgreSQL + Cloudflare R2
# ==============================================================================

ENVIRONMENT=staging
PROJECT_NAME="Smart Restaurant Management Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
LOG_LEVEL=INFO

# Cryptographic Security
SECRET_KEY="<256-bit-cryptographically-secure-random-key>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_SECRET="<256-bit-cryptographically-secure-random-key>"

# Render Managed Database (PostgreSQL 16 with SSL)
DATABASE_URL="postgresql://srmp_admin:<password>@dpg-<id>-a.singapore-postgres.render.com/srmp_staging?sslmode=require"

# Hosting Domains & CORS (Temporary subdomains)
FRONTEND_URL="https://srmp-platform.web.app"
BACKEND_CORS_ORIGINS=["https://srmp-platform.web.app","https://srmp-platform.firebaseapp.com","https://srmp-backend.onrender.com","http://localhost:5173"]

# Platform Razorpay Merchant Gateway (Flow B: SaaS Subscriptions - TEST MODE)
PLATFORM_RAZORPAY_KEY_ID="rzp_test_platform_key_2026"
PLATFORM_RAZORPAY_KEY_SECRET="<platform-test-secret>"
PLATFORM_RAZORPAY_WEBHOOK_SECRET="<platform-test-webhook-secret>"
PLATFORM_SETTLEMENT_BANK_NAME=""
PLATFORM_SETTLEMENT_ACCOUNT=""
PLATFORM_SETTLEMENT_IFSC=""

# Individual Business Identity & GST Defaults (Test Mode / Non-GST Unregistered)
BUSINESS_OPERATING_MODEL="INDIVIDUAL_UNREGISTERED"
OWNER_LEGAL_NAME=""
BRAND_TRADE_NAME="SRMP (Smart Restaurant Management Platform)"
BUSINESS_IDENTITY_STATUS="PENDING_OWNER_CONFIGURATION"
IS_GST_REGISTERED=false
IS_GST_RATE_CA_CONFIRMED=false
PRODUCTION_DOMAIN=""

# Restaurant Payments Safety: Fallback strictly DISABLED in staging/production
DISABLE_RESTAURANT_PAYMENT_FALLBACK=true

# Persistent Object Storage (Cloudflare R2)
STORAGE_BACKEND="s3"
S3_BUCKET_NAME="srmp-staging-uploads"
S3_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="<r2_access_key_id>"
S3_SECRET_ACCESS_KEY="<r2_secret_access_key>"
S3_REGION="auto"
S3_PUBLIC_BASE_URL="https://pub-<hash>.r2.dev"

# Transactional Email (Resend) - Disabled until verified domain is active
ENABLE_TRANSACTIONAL_EMAIL=false
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Error Monitoring (Sentry)
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
