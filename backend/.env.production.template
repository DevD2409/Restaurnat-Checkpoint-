# ==============================================================================
# SRMP Multi-Tenant SaaS - Render Production Environment Variable Template
# SECURITY DIRECTIVE: NEVER commit live secrets to git, chats, or audit logs.
# All live credentials must be provisioned directly via Render Secret Dashboard.
# ==============================================================================

# Application Runtime Configuration
ENVIRONMENT=production
PROJECT_NAME="Smart Restaurant Management Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
LOG_LEVEL=INFO

# Managed PostgreSQL Database (Render Managed PostgreSQL Connection String)
# Render automatic injection: DATABASE_URL (sync from srmp-postgres service)
DATABASE_URL=postgresql://srmp_admin:[REDACTED_POSTGRES_PASSWORD]@dpg-[REDACTED].singapore-postgres.render.com/srmp_production

# JWT & Token Cryptographic Signing
SECRET_KEY=[REDACTED_SECURE_RANDOM_64_CHAR_HEX]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_SECRET=[REDACTED_SECURE_RANDOM_64_CHAR_HEX]

# Domain & CORS Origins (Temporary deployment URLs work until PRODUCTION_DOMAIN is set)
FRONTEND_URL=https://srmp-platform.web.app
PRODUCTION_DOMAIN=
BACKEND_CORS_ORIGINS=["https://srmp-platform.web.app","https://srmp-platform.firebaseapp.com"]

# ==============================================================================
# INDIVIDUAL BUSINESS IDENTITY & COMPLIANCE CONFIGURATION
# Operating Model: Individual / Unregistered Business (until verified credentials provided)
# ==============================================================================
BUSINESS_OPERATING_MODEL=INDIVIDUAL_UNREGISTERED
OWNER_LEGAL_NAME=
BRAND_TRADE_NAME="SRMP (Smart Restaurant Management Platform)"
BUSINESS_IDENTITY_STATUS=PENDING_OWNER_CONFIGURATION
BUSINESS_ADDRESS=
BUSINESS_PAN=

# GST Registration (Must remain FALSE unless genuine GSTIN + CA confirmation supplied)
IS_GST_REGISTERED=false
OWNER_GSTIN=
IS_GST_RATE_CA_CONFIRMED=false
GST_RATE_PERCENTAGE=18.0
SUPPLIER_GST_STATE_CODE=
SAC_CODE=
SAC_DESCRIPTION=

# Support & Grievance Contact Channels (Leave blank until real channels configured)
SUPPORT_EMAIL=
GRIEVANCE_EMAIL=
TELEPHONE_HELPLINE=
GRIEVANCE_CONTACT_NAME=
REFUND_POLICY_APPROVED=false

# ==============================================================================
# FLOW B — PLATFORM SAAS SUBSCRIPTION PAYMENT CONFIGURATION
# Settlement Destination: Platform Owner's Verified Individual Bank Account
# Pricing: Monthly ₹999 (99,900 paise) / Yearly ₹9,999 (999,900 paise) tax-inclusive
# ==============================================================================
# Leave empty while EMERGENCY_DISABLE_PAYMENTS=true / FLOW_B_ENABLED=false.
# Provision real Razorpay credentials directly in Render Environment Variables ONLY after KYC approval.
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
PLATFORM_RAZORPAY_WEBHOOK_SECRET=
PLATFORM_SETTLEMENT_BANK_NAME=
PLATFORM_SETTLEMENT_ACCOUNT=
PLATFORM_SETTLEMENT_IFSC=

# ==============================================================================
# PAYMENT SAFETY GATES & CIRCUIT BREAKERS (CRITICAL)
# Fail-closed defaults for Render Free-tier TEST deployment.
# Do NOT enable live payments or flows without explicit owner approval & credentials.
# ==============================================================================
LIVE_MODE_FLOW_A=false
LIVE_MODE_FLOW_B=false
FLOW_A_ENABLED=false
FLOW_B_ENABLED=false
DISABLE_RESTAURANT_PAYMENT_FALLBACK=true
EMERGENCY_DISABLE_PAYMENTS=true

# ==============================================================================
# TEMPORARY LOCAL STORAGE (RENDER FREE TEST DEPLOYMENT)
# NOTE: On Render Free Web Services, local filesystem (/static/uploads) is
# EPHEMERAL — uploaded files do NOT persist across restarts, sleep, or redeploys.
# Switch STORAGE_BACKEND=s3 with S3_*/R2 credentials when persistent media is ready.
# ==============================================================================
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# ==============================================================================
# TRANSACTIONAL EMAIL (RESEND) - DISABLED UNTIL VERIFIED SENDING DOMAIN
# ==============================================================================
ENABLE_TRANSACTIONAL_EMAIL=false
RESEND_API_KEY=[REDACTED_RESEND_KEY]
RESEND_FROM_EMAIL=

# ==============================================================================
# PRODUCTION OBSERVABILITY & SAFE INITIALIZATION
# ==============================================================================
SENTRY_DSN=
SEED_DEMO_DATA=false
