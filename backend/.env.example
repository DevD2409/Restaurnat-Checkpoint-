PROJECT_NAME="Smart Restaurant Management Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="production-super-secret-jwt-key-replace-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_SECRET="smart-restaurant-qr-secure-salt-2026"

# Database: SQLite for development, PostgreSQL for production
# Local SQLite: sqlite:///./smart_restaurant.db
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/smart_restaurant_db
DATABASE_URL="sqlite:///./smart_restaurant.db"

# Razorpay Sandbox Credentials
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"

