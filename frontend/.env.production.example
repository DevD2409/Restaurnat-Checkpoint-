# ==============================================================================
# SRMP Multi-Tenant Frontend - Production Environment Configuration
# Copy to `frontend/.env.production.local` (gitignored) or pass via shell env
# once the Render production backend URL is assigned, then run `npm run build`
# and deploy `frontend/dist` to Firebase Hosting.
# ==============================================================================

# Backend API URL (replace <your-render-service> with your live Render URL)
VITE_API_URL=https://<your-render-service>.onrender.com/api/v1

# Secure WebSocket URL (wss://)
VITE_WS_URL=wss://<your-render-service>.onrender.com/ws

# Branding Title
VITE_APP_TITLE="Smart Restaurant Management Platform"
